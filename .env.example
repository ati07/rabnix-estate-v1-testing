# ---------------------------------------------------------------------------
# Rabnix Estate — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# DATABASE_URL: PostgreSQL connection string used by Prisma.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgres://postgres:password@localhost:5432/rabnix_estate"

# JWT_SECRET: Secret used to sign session JWTs (jose, HS256).
# Generate a strong random value, e.g.:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# GEMINI_API_KEY: Google Gemini API key for the AI property advisor
# (src/app/api/gemini/advisor). Optional — the advisor feature is disabled
# without it, but the rest of the app works.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BLOB_READ_WRITE_TOKEN: Vercel Blob token used by /api/upload for image
# uploads (property photos, profile avatars) IN PRODUCTION. Local development
# writes uploads to public/uploads/ instead, so this token is NOT required for
# `npm run dev`. On Vercel it is injected automatically once a Blob store is
# connected to the project (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX"

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Razorpay API credentials used by the
# listing-plan billing flow (/api/billing/*). Get them from the Razorpay
# Dashboard → Settings → API Keys (use test keys during development).
# IN DEVELOPMENT: if these are left unset, the buy flow runs in a test-mode
# bypass that simulates a successful payment (no real charge) so the whole
# plan/quota flow can be exercised locally. IN PRODUCTION these are REQUIRED —
# without them the buy buttons return an error.
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"
